Bootstrap: docker
From: continuumio/miniconda3
   
%files
    /home/fall/Gits/Monsda/envs/rammap.yaml /opt/envs/
    /home/fall/Gits/Monsda/scripts /opt/MONSDA/

%environment
   
%post
    find /opt/MONSDA/scripts -type f \( -name '*.py' -o -name '*.R' -o -name '*.sh' -o -name '*.pl' \) -exec chmod a+x {} +
    ls -alrt /opt/envs
    chmod -R +x /opt/envs/rammap.yaml
    
    ENV_NAME=rammap
    echo ". /opt/conda/etc/profile.d/conda.sh" >> $APPTAINER_ENVIRONMENT
    echo "conda activate $ENV_NAME" >> $APPTAINER_ENVIRONMENT
   
    . /opt/conda/etc/profile.d/conda.sh
    conda env create -f /opt/envs/rammap.yaml -p /opt/conda/envs/$ENV_NAME
    conda clean --all
   
%runscript
    exec "$@"
