Bootstrap: docker
From: continuumio/miniconda3:latest
   
%files
    ${HOME}/MONSDA/envs/bowtie2.yaml /opt/envs/
    ${HOME}/MONSDA/scripts /opt/MONSDA/

%environment
   
%post
    find /opt/MONSDA/scripts -type f \( -name '*.py' -o -name '*.R' -o -name '*.sh' -o -name '*.pl' \) -exec chmod a+x {} +
    ls -alrt /opt/envs
    chmod -R +x /opt/envs/bowtie2.yaml
    
    ENV_NAME=bowtie2
    echo ". /opt/conda/etc/profile.d/conda.sh" >> $APPTAINER_ENVIRONMENT
    echo "conda activate $ENV_NAME" >> $APPTAINER_ENVIRONMENT
   
    . /opt/conda/etc/profile.d/conda.sh
    conda env create -f /opt/envs/bowtie2.yaml -p /opt/conda/envs/$ENV_NAME
    conda clean --all
   
%runscript
    exec "$@"
